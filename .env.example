# WellRead Environment Variables
# Copy this file to .env and update with your actual values

# GraphQL Backend URL (REQUIRED)
# This environment variable is required for the application to work.
# For local development: http://localhost:4000
# For production: https://your-backend-url.com/graph
VITE_GRAPH_URL=http://localhost:4000

# Optional: Add other environment variables here as needed
# VITE_API_TIMEOUT=30000
# VITE_ENABLE_ANALYTICS=false
